{
 "title": "Time and care in Europe",
 "about": "A worked example on Eurostat's open data: how women's and men's days divide among eight activities in eighteen countries (the harmonised time use surveys of 2010), compared as compositions of 1440 minutes; who carries the unpaid work and what it is worth at a declared wage, the years lived in health in each country (held against Eurostat's own healthy life years), the care Europe's ageing populations will need by 2050 and what makes the need grow, and the unemployment a labour market's flows hold, quarter by quarter.",
 "needs": [
  "products/time-and-care/days.csv",
  "products/time-and-care/life-tables.csv",
  "products/time-and-care/limitation.csv",
  "products/time-and-care/healthy-life.csv",
  "products/time-and-care/population.csv",
  "products/time-and-care/projections.csv",
  "products/time-and-care/labour-flows.csv"
 ],
