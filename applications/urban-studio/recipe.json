{
  "title": "The Urban Studio's engines, and the data of its examples",
  "about": "The engines of its plug-ins (the ecology plug-in's on the ecology domain; the provision plug-in's on sociology, social provision, demography's health and economics' labour), compiled with g++ 11 or later (natively or in WSL) into data/cache/engines/urban-studio/; then, for the examples, the City of Melbourne's urban forest (82,064 trees, about 52 MB), its tree canopies of 2021 (about 270 MB) and its census blocks (CC BY 4.0), New York City's 2015 Street Tree Census (about 90 MB, NYC Open Data), the census of land use's dwellings for the blocks' table, and the products made from them. A project on one's own data needs only the engines. For the provision plug-in's example: Eurostat's time use surveys, healthy life years, limitation in usual activities, life tables, population, projections and labour market transitions (CC BY 4.0, about 10 MB), and the tables made from them.",
  "steps": [
    {
      "id": "engines",
      "title": "The plug-ins' engines, compiled with g++",
      "run": [
        "applications/urban-studio/engine.py",
        "build"
      ],
      "done": "data/cache/engines/urban-studio/provision/build.json"
    },
    {
      "id": "melbourne-urban-forest",
      "title": "Melbourne's urban forest: every tree the City manages",
      "run": [
        "data/acquisition/fetch.py",
        "melbourne-urban-forest"
      ],
      "done": "data/cache/melbourne-urban-forest/**/retrieval.json"
    },
    {
      "id": "melbourne-tree-canopies",
      "title": "Melbourne's tree canopies of 2021",
      "run": [
        "data/acquisition/fetch.py",
        "melbourne-tree-canopies"
      ],
      "done": "data/cache/melbourne-tree-canopies/**/retrieval.json"
    },
    {
      "id": "melbourne-clue-blocks",
      "title": "The census's blocks",
      "run": [
        "data/acquisition/fetch.py",
        "melbourne-clue-blocks"
      ],
      "done": "data/cache/melbourne-clue-blocks/**/retrieval.json"
    },
    {
      "id": "melbourne-clue-dwellings",
      "title": "Dwellings, block by block",
      "run": [
        "data/acquisition/fetch.py",
        "melbourne-clue-dwellings"
      ],
      "done": "data/cache/melbourne-clue-dwellings/**/retrieval.json"
    },
    {
      "id": "city-tables",
      "title": "The blocks' table: floor space, businesses and dwellings, year by year",
      "run": [
        "data/products/city_tables.py"
      ],
      "done": "data/cache/products/tables/melbourne-blocks.json"
    },
    {
      "id": "nyc-street-trees-2015",
      "title": "New York City's 2015 Street Tree Census",
      "run": [
        "data/acquisition/fetch.py",
        "nyc-street-trees-2015"
      ],
      "done": "data/cache/nyc-street-trees-2015/**/retrieval.json"
    },
    {
      "id": "urban-forest",
      "title": "The urban forests as tables: trees, blocks and their canopy",
      "run": [
        "data/products/urban_forest.py"
      ],
      "done": "data/cache/products/urban-forest/melbourne-trees.csv"
    },
    {
      "id": "eurostat-time-use",
      "title": "Eurostat's harmonised time use surveys",
      "run": [
        "data/acquisition/fetch.py",
        "eurostat-time-use"
      ],
      "done": "data/cache/eurostat-time-use/**/retrieval.json"
    },
    {
      "id": "eurostat-healthy-life-years",
      "title": "Eurostat's healthy life years",
      "run": [
        "data/acquisition/fetch.py",
        "eurostat-healthy-life-years"
      ],
      "done": "data/cache/eurostat-healthy-life-years/**/retrieval.json"
    },
    {
      "id": "eurostat-activity-limitation",
      "title": "Limitation in usual activities (EU-SILC)",
      "run": [
        "data/acquisition/fetch.py",
        "eurostat-activity-limitation"
      ],
      "done": "data/cache/eurostat-activity-limitation/**/retrieval.json"
    },
    {
      "id": "eurostat-life-tables",
      "title": "Eurostat's life tables",
      "run": [
        "data/acquisition/fetch.py",
        "eurostat-life-tables"
      ],
      "done": "data/cache/eurostat-life-tables/**/retrieval.json"
    },
    {
      "id": "eurostat-population",
      "title": "Population by single age",
      "run": [
        "data/acquisition/fetch.py",
        "eurostat-population"
      ],
      "done": "data/cache/eurostat-population/**/retrieval.json"
    },
    {
      "id": "eurostat-population-projections",
      "title": "Population projections (EUROPOP2023)",
      "run": [
        "data/acquisition/fetch.py",
        "eurostat-population-projections"
      ],
      "done": "data/cache/eurostat-population-projections/**/retrieval.json"
    },
    {
      "id": "eurostat-labour-transitions",
      "title": "Labour market transitions",
      "run": [
        "data/acquisition/fetch.py",
        "eurostat-labour-transitions"
      ],
      "done": "data/cache/eurostat-labour-transitions/**/retrieval.json"
    },
    {
      "id": "time-and-care",
      "title": "Time, health, care and work in Europe as tables",
      "run": [
        "data/products/time_and_care.py"
      ],
      "done": "data/cache/products/time-and-care/days.csv"
    }
  ]
}
