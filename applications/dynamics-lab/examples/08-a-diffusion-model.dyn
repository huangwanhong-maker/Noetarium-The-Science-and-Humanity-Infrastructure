# A random model: the forward process of a diffusion model
# Noise is a declared source with its law, and the calculus is stated. The forward process carries any start towards a normal law; generating runs it backwards, with the score unknown.
#! {"tool": "run", "system": "forward", "initial": {"X1": 2, "X2": -1.5}, "t1": 1, "step": 0.001, "every": 5, "view": "series"}
#! {"tool": "run", "system": "forward", "initial": {"X1": 2, "X2": -1.5}, "t1": 1, "step": 0.001, "every": 2, "view": "phase", "x": "X1", "y": "X2"}
#! {"tool": "run", "system": "heavy_tails", "initial": {"x": 0}, "t1": 2000, "view": "series"}

system forward {
  state X(t) : real^d
  param d = 2, T = 1, beta(u) = 0.1 + 19.9 * u
  noise W : wiener(d)
  noise X(0) ~ data
  change { dX = -beta(t)/2 * X * dt + sqrt(beta(t)) * dW }
  structure { time t in [0, T] ; weights probability ; calculus ito }
}

# Its time reversal (Anderson 1982), which leaves one unknown: the score. Declared; not carried out yet.
system generate = reverse forward

# A map with noise of another law: draws from a stable law of index 1.5, with heavy tails.
system heavy_tails {
  state x : real
  param a = 0.9
  noise xi : levy(1.5)
  change { x' = a * x + 0.05 * xi }
  structure { time n in natural ; weights probability }
}
