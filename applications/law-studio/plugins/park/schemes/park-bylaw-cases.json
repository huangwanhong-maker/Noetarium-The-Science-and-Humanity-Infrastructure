{
  "schema": "noetarium.scheme/1",
  "id": "park-bylaw-cases",
  "title": "The Park Bylaw of Avalon, with its case law (invented)",
  "as_of": "2026-01-01",
  "about": "The invented bylaw of Hart's park with an invented case law: decided cases on what the word 'vehicle' reaches, and precedents on what counts as an emergency, decided by factors, whose courts did not say which factor decided them. Every word of it is made up for the example, and none of it is any jurisdiction's law.",
  "instruments": [
    {
      "id": "park-bylaw",
      "title": "Park Bylaw 2010 (Borough of Avalon)",
      "citation": "PB 2010",
      "kind": "bylaw",
      "as_of": "2010-01-01",
      "url": "",
      "provisions": [
        {
          "id": "pb/1",
          "label": "Section 1",
          "text": "Vehicles in the park."
        },
        {
          "id": "pb/1/1",
          "label": "Section 1(1)",
          "text": "No vehicle may be taken into the park.",
          "parent": "pb/1"
        },
        {
          "id": "pb/1/2",
          "label": "Section 1(2)",
          "text": "Subsection (1) does not apply to a vehicle used in an emergency.",
          "parent": "pb/1"
        },
        {
          "id": "pb/2",
          "label": "Section 2",
          "text": "A person who takes into the park anything that subsection 1(1) forbids commits an offence."
        }
      ]
    }
  ],
