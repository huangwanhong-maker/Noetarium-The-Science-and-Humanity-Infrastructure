# The simplex category from its identities
# Faces and degeneracies with the cosimplicial identities present the simplex category up to [2]: completion builds its 31 arrows.

category D {
  d0, d1 : n0 -> n1
  s0 : n1 -> n0
  e0, e1, e2 : n1 -> n2
  t0, t1 : n2 -> n1
  e1 . d0 = e0 . d0
  e2 . d0 = e0 . d1
  e2 . d1 = e1 . d1
  s0 . d0 = id n0
  s0 . d1 = id n0
  t0 . e0 = id n1
  t0 . e1 = id n1
  t1 . e1 = id n1
  t1 . e2 = id n1
  t1 . e0 = d0 . s0
  t0 . e2 = d1 . s0
  s0 . t0 = s0 . t1
}
category Delta = simplex 2
check D isomorphic Delta

# A face that is a composite of the others: the faces and degeneracies generate, and are not the fewest that do.
check d0 = t1 . e0 . d1 in D
find rules D
