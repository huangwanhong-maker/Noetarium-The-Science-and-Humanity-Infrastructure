    {"who": "citizen", "may": ["propose", "vote", "assign", "release"]},
    {"who": "magistrate", "may": ["grant", "admit", "convert", "deploy", "sign for the community", "amend"]},
    {"who": "juror", "may": ["assess", "vote"], "in": ["court"]},
    {"who": "juror", "must": ["answer"], "when": "a claim is admitted", "within": "two rounds", "or else": "a new jury is drawn"},
    {"who": "envoy", "may": ["offer", "report"], "in": ["chancery"]},
    {"who": "magistrate", "must never": ["assess"], "in": ["court"]}
  ],
  "bodies": {
    "assembly": {"of": ["citizen"]},
    "magistrates": {"of": ["magistrate"]},
    "jury": {"of": ["juror"], "size": 5, "drawn by lot": true}
  },
  "aggregation": {
    "make law": {"body": "assembly", "rule": "majority", "count by": "person", "tempo": "deliberative"},
    "naturalise": {"body": "assembly", "rule": "majority", "count by": "person", "tempo": "deliberative"},
    "elect magistrates": {"body": "assembly", "rule": "majority", "count by": "person", "tempo": "deliberative"},
    "appoint envoy": {"body": "magistrates", "rule": "majority", "count by": "person", "tempo": "deliberative"},
    "issue": {"body": "magistrates", "rule": "majority", "count by": "person", "tempo": "deliberative"},
    "judge claim": {"body": "jury", "rule": "majority", "count by": "person", "tempo": "deliberative"},
    "amend constitutional": {"body": "assembly", "rule": "two thirds", "count by": "person", "tempo": "constitutional"}
  },
  "scenes": {
