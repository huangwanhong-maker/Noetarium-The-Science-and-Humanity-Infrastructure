    "assembly": {"acts": ["propose", "vote", "amend"], "read": "anyone", "write": ["citizen"], "presence": "persons", "tempo": "deliberative"},
    "court": {"acts": ["claim", "assess", "vote", "answer"], "read": ["juror", "magistrate"], "write": "anyone", "presence": "persons", "tempo": "deliberative"},
    "chancery": {"acts": ["offer", "report"], "read": ["magistrate", "envoy"], "write": ["envoy"], "presence": "mixed", "tempo": "deliberative"}
  },
  "payoff": {"returns": {"basis": "agreement", "rule": "shares and services by law of the assembly"}, "sanctions": ["note", "fine in the unit of account", "suspension", "exclusion"]},
