{
  "format": "noetarium.constitution/1",
  "name": "polity",
  "purpose": "A polity with selective citizenship, an assembly, magistrates, juries drawn by lot and a unit of account.",
  "positions": {
    "resident": {"held by": ["person", "organisation", "operative"]},
    "citizen": {"held by": ["person"]},
    "magistrate": {"held by": ["person"]},
    "juror": {"held by": ["person"]},
    "envoy": {"held by": ["person", "operative"]}
  },
  "boundary": {
    "resident": {"entry": "open", "exit": "free"},
    "citizen": {"entry": {"after": "residence"}, "exit": {"notice": "one round"}},
    "magistrate": {"entry": {"decided by": "elect magistrates"}, "exit": {"notice": "one round"}},
    "juror": {"entry": {"by lot among": "citizen"}, "exit": "free"},
    "envoy": {"entry": {"decided by": "appoint envoy"}, "exit": "free"}
  },
  "choice": [
    {"who": "anyone", "may": ["say", "claim"]},
